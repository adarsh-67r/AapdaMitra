{
  "expo": {
    "name": "Aapda Mitra",
    "slug": "aapdamitra-citizen",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "citizenapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.aapdamitra.citizen"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2efe6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aapdamitra.citizen",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f2efe6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#14120f"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Aapda Mitra uses your location to tag incident reports and find nearby shelters."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aapda Mitra accesses your photos so you can attach one to an incident report.",
          "cameraPermission": "Aapda Mitra uses your camera so you can photograph an incident to report it."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "61564127-3185-4010-b820-16a9d457f04e"
      }
    },
    "owner": "adarsh67r"
  }
}
